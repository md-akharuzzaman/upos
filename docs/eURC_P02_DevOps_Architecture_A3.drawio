rce="c62" target="c63"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c70" value="④ Zero-downtime release with a staging slot" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=12;fontColor=#0078D4;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="555" y="795" width="520" height="280" as="geometry"/></mxCell><mxCell id="c71" value="&lt;b&gt;Before&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontColor=#1F2937;verticalAlign=middle;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="575" y="830" width="150" height="20" as="geometry"/></mxCell><mxCell id="c72" value="production&lt;br&gt;&lt;span style='font-weight:normal;font-size:13px'&gt;v1&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#0078D4;strokeWidth=1;verticalAlign=middle;align=center;spacingLeft=8;spacingTop=4;fontSize=10;fontColor=#0078D4;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="575" y="855" width="150" height="60" as="geometry"/></mxCell><mxCell id="c73" value="staging&lt;br&gt;&lt;span style='font-weight:normal;font-size:13px'&gt;v2 (new)&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1;verticalAlign=middle;align=center;spacingLeft=8;spacingTop=4;fontSize=10;fontColor=#0078D4;fontFamily=Segoe UI;fontStyle=1;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="575" y="925" width="150" height="60" as="geometry"/></mxCell><mxCell id="c74" value="&lt;b&gt;Swap&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontColor=#1F2937;verticalAlign=middle;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="740" y="830" width="150" height="20" as="geometry"/></mxCell><mxCell id="c75" value="production&lt;br&gt;&lt;span style='font-weight:normal;font-size:13px'&gt;warm-up&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#0078D4;strokeWidth=1;verticalAlign=middle;align=center;spacingLeft=8;spacingTop=4;fontSize=10;fontColor=#0078D4;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="740" y="855" width="150" height="60" as="geometry"/></mxCell><mxCell id="c76" value="staging&lt;br&gt;&lt;span style='font-weight:normal;font-size:13px'&gt;/health = 200&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1;verticalAlign=middle;align=center;spacingLeft=8;spacingTop=4;fontSize=10;fontColor=#0078D4;fontFamily=Segoe UI;fontStyle=1;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="740" y="925" width="150" height="60" as="geometry"/></mxCell><mxCell id="c77" value="&lt;b&gt;After&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontColor=#1F2937;verticalAlign=middle;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="905" y="830" width="150" height="20" as="geometry"/></mxCell><mxCell id="c78" value="production&lt;br&gt;&lt;span style='font-weight:normal;font-size:13px'&gt;v2&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#0078D4;strokeWidth=1;verticalAlign=middle;align=center;spacingLeft=8;spacingTop=4;fontSize=10;fontColor=#0078D4;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="905" y="855" width="150" height="60" as="geometry"/></mxCell><mxCell id="c79" value="staging&lt;br&gt;&lt;span style='font-weight:normal;font-size:13px'&gt;v1 (previous)&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1;verticalAlign=middle;align=center;spacingLeft=8;spacingTop=4;fontSize=10;fontColor=#0078D4;fontFamily=Segoe UI;fontStyle=1;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="905" y="925" width="150" height="60" as="geometry"/></mxCell><mxCell id="c80" value="Users stay on production while staging is deployed and tested. The swap only switches routing after the staging instances answer /health. The previous version stays warm in staging, so a rollback is just another swap. EURC_SLOT is a slot setting (sticky); everything else moves with the code. Both slots use the same database ⇒ migrations must be expand-only." style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontColor=#1F2937;verticalAlign=middle;fontSize=9.5;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="570" y="995" width="495" height="78" as="geometry"/></mxCell><mxCell id="c81" value="" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0B2A4A;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=12;fontColor=#0B2A4A;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1090" y="795" width="544" height="194" as="geometry"/></mxCell><mxCell id="c82" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:9.5px;font-family:Segoe UI&quot;&gt;&lt;tr&gt;&lt;th style=&quot;background:#0B2A4A;color:#fff;text-align:left;padding:3px 5px&quot;&gt;Stage&lt;/th&gt;&lt;th style=&quot;background:#0B2A4A;color:#fff;text-align:left;padding:3px 5px&quot;&gt;Gate&lt;/th&gt;&lt;th style=&quot;background:#0B2A4A;color:#fff;text-align:left;padding:3px 5px&quot;&gt;Pass condition&lt;/th&gt;&lt;th style=&quot;background:#0B2A4A;color:#fff;text-align:left;padding:3px 5px&quot;&gt;On failure&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#FFFFFF;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;PR&lt;/td&gt;&lt;td style=&quot;background:#FFFFFF;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;4 checks + review&lt;/td&gt;&lt;td style=&quot;background:#FFFFFF;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;green · code owner approved&lt;/td&gt;&lt;td style=&quot;background:#FFFFFF;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;merge blocked&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F6F8FB;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;build&lt;/td&gt;&lt;td style=&quot;background:#F6F8FB;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;API + React tests&lt;/td&gt;&lt;td style=&quot;background:#F6F8FB;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;48 pass · ≥ 80 % lines each&lt;/td&gt;&lt;td style=&quot;background:#F6F8FB;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;no artifact&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#FFFFFF;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;dev&lt;/td&gt;&lt;td style=&quot;background:#FFFFFF;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;smoke&lt;/td&gt;&lt;td style=&quot;background:#FFFFFF;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;8/8 · expected version&lt;/td&gt;&lt;td style=&quot;background:#FFFFFF;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;stop&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F6F8FB;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;test&lt;/td&gt;&lt;td style=&quot;background:#F6F8FB;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;integration · load&lt;/td&gt;&lt;td style=&quot;background:#F6F8FB;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;13/13 · p95 &amp;lt; 1.5 s&lt;/td&gt;&lt;td style=&quot;background:#F6F8FB;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;stop&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#FFFFFF;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;test&lt;/td&gt;&lt;td style=&quot;background:#FFFFFF;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;Playwright E2E&lt;/td&gt;&lt;td style=&quot;background:#FFFFFF;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;10/10 (2 devices)&lt;/td&gt;&lt;td style=&quot;background:#FFFFFF;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;stop&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F6F8FB;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;prod&lt;/td&gt;&lt;td style=&quot;background:#F6F8FB;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;QA sign-off&lt;/td&gt;&lt;td style=&quot;background:#F6F8FB;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;tester approves&lt;/td&gt;&lt;td style=&quot;background:#F6F8FB;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;waits&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#FFFFFF;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;prod&lt;/td&gt;&lt;td style=&quot;background:#FFFFFF;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;staging smoke&lt;/td&gt;&lt;td style=&quot;background:#FFFFFF;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;8/8 on staging&lt;/td&gt;&lt;td style=&quot;background:#FFFFFF;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;no swap&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F6F8FB;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;prod&lt;/td&gt;&lt;td style=&quot;background:#F6F8FB;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;verify + gate&lt;/td&gt;&lt;td style=&quot;background:#F6F8FB;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;8/8 · failures &amp;lt; 2 %&lt;/td&gt;&lt;td style=&quot;background:#F6F8FB;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;auto swap back&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=top;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1095" y="800" width="534" height="186" as="geometry"/></mxCell><mxCell id="c83" value="Secrets in the pipeline: &lt;b&gt;none&lt;/b&gt;. GitHub holds IDs only; each job gets a short-lived Entra token for one resource group." style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontColor=#1F2937;verticalAlign=middle;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1090" y="995" width="360" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
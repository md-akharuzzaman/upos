-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;CD, every merge&lt;/td&gt;&lt;td style=&quot;background:#F6F8FB;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;CD, after dev&lt;/td&gt;&lt;td style=&quot;background:#F6F8FB;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;CD, after QA sign-off&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#FFFFFF;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;Approval&lt;/td&gt;&lt;td style=&quot;background:#FFFFFF;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;—&lt;/td&gt;&lt;td style=&quot;background:#FFFFFF;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;none (main only)&lt;/td&gt;&lt;td style=&quot;background:#FFFFFF;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;none (main only)&lt;/td&gt;&lt;td style=&quot;background:#FFFFFF;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;&lt;b&gt;tester&lt;/b&gt; or lead; not the run's trigger&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F6F8FB;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;Data&lt;/td&gt;&lt;td style=&quot;background:#F6F8FB;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;in-memory demo&lt;/td&gt;&lt;td style=&quot;background:#F6F8FB;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;test data&lt;/td&gt;&lt;td style=&quot;background:#F6F8FB;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;test data (E2E cleans up)&lt;/td&gt;&lt;td style=&quot;background:#F6F8FB;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;live, private endpoints&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#FFFFFF;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;Azure identity&lt;/td
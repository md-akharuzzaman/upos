font-weight:700;padding:4px 8px;font-size:11px;width:184px'&gt;dbo.sales&lt;/div&gt;&lt;table style='border-collapse:collapse;width:100%;font-family:Segoe UI'&gt;&lt;tr&gt;&lt;td style='padding:1px 6px;color:#B45309;font-size:9px;width:34px'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;font-size:10px'&gt;id&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px;color:#5C2D91;font-size:9px;width:34px'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;font-size:10px'&gt;store_id → stores&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px;color:#94A3B8;font-size:9px;width:34px'&gt;&lt;b&gt;UQ&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;font-size:10px'&gt;(store_id, receipt_no)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px;color:#94A3B8;font-size:9px;width:34px'&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;font-size:10px'&gt;cashier_id · cashier_name&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px;color:#94A3B8;font-size:9px;width:34px'&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;font-size:10px'&gt;subtotal · tax · total _cents&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px;color:#94A3B8;font-size:9px;width:34px'&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;font-size:10px'&gt;payment_method cash | card&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px;color:#94A3B8;font-size:9px;width:34px'&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;font-size:10px'&gt;tendered · change _cents&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px;color:#94A3B8;font-size:9px;width:34px'&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;font-size:10px'&gt;card_reference (no card data)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px;color:#94A3B8;font-size:9px;width:34px'&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;font-size:10px'&gt;status completed | refun
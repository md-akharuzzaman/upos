rtex="1" parent="1"><mxGeometry x="740" y="585" width="880" height="30" as="geometry"/></mxCell><mxCell id="c50" value="C · REST API (JSON over HTTPS)" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0B2A4A;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=12;fontColor=#0B2A4A;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="635" width="800" height="420" as="geometry"/></mxCell><mxCell id="c51" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:9.5px;font-family:Segoe UI&quot;&gt;&lt;tr&gt;&lt;th style=&quot;background:#0B2A4A;color:#fff;text-align:left;padding:3px 5px&quot;&gt;Method&lt;/th&gt;&lt;th style=&quot;background:#0B2A4A;color:#fff;text-align:left;padding:3px 5px&quot;&gt;Path&lt;/th&gt;&lt;th style=&quot;background:#0B2A4A;color:#fff;text-align:left;padding:3px 5px&quot;&gt;Who&lt;/th&gt;&lt;th style=&quot;background:#0B2A4A;color:#fff;text-align:left;padding:3px 5px&quot;&gt;Purpose&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#FFFFFF;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;GET&lt;/td&gt;&lt;td style=&quot;background:#FFFFFF;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;/health · /health/live&lt;/td&gt;&lt;td style=&quot;background:#FFFFFF;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;public&lt;/td&gt;&lt;td style=&quot;background:#FFFFFF;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;readiness (SQL, Blob, KV, schema) · liveness&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F6F8FB;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;GET&lt;/td&gt;&lt;td style=&quot;background:#F6F8FB;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;/api/info&lt;/td&gt;&lt;td style=&quot;background:#F6F8FB;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;public&lt;/td&gt;&lt;td style=&quot;background:#F6F8FB;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;version, commit, environment, slot&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#FFFFFF;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;POST&lt;/td&gt;&lt;td style=&quot;background:#FFFFFF;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;/api/stores&lt;/td&gt;&lt;td style=&quot;background:#FFFFFF;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;public, rate-limited&lt;/td&gt;&lt;td style=&quot;background:#FFFFFF;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;create store + manager → session&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F6F8FB;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;POST&lt;/td&gt;&lt;td style=&quot;background:#F6F8FB;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;/api/auth/login&lt;/td&gt;&lt;td style=&quot;background:#F6F8FB;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;public, rate-limited&lt;/td&gt;&lt;td style=&quot;background:#F6F8FB;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;store code + e-mail + password → session&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#FFFFFF;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;GET&lt;/td&gt;&lt;td style=&quot;background:#FFFFFF;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;/api/me&lt;/td&gt;&lt;td style=&quot;background:#FFFFFF;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;signed in&lt;/td&gt;&lt;td style=&quot;background:#FFFFFF;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;current user and store&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F6F8FB;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;GET · POST · PATCH&lt;/td&gt;&lt;td style=&quot;background:#F6F8FB;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;/api/users[/:id]&lt;/td&gt;&lt;td style=&quot;background:#F6F8FB;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;manager&lt;/td&gt;&lt;td style=&quot;background:#F6F8FB;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;list, add, (de)activate staff&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#FFFFFF;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;GET&lt;/td&gt;&lt;td style=&quot;background:#FFFFFF;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;/api/products?q=&amp;amp;all=1&lt;/td&gt;&lt;td style=&quot;background:#FFFFFF;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;signed in&lt;/td&gt;&lt;td style=&quot;background:#FFFFFF;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;catalogue (all=1: hidden too, manager)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F6F8FB;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;POST · PATCH&lt;/td&gt;&lt;td style=&quot;background:#F6F8FB;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;/api/products[/:id]&lt;/td&gt;&lt;td style=&quot;background:#F6F8FB;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;manager&lt;/td&gt;&lt;td style=&quot;background:#F6F8FB;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;add, edit price/tax/stock, hide&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#FFFFFF;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;POST&lt;/td&gt;&lt;td style=&quot;background:#FFFFFF;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;/api/sales&lt;/td&gt;&lt;td style=&quot;background:#FFFFFF;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;signed in&lt;/td&gt;&lt;td style=&quot;background:#FFFFFF;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;checkout (flow B)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F6F8FB;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;GET&lt;/td&gt;&lt;td style=&quot;background:#F6F8FB;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;/api/sales?date=&amp;amp;tz=&lt;/td&gt;&lt;td style=&quot;background:#F6F8FB;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;signed in&lt;/td&gt;&lt;td style=&quot;background:#F6F8FB;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;sales of a local day&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#FFFFFF;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;GET&lt;/td&gt;&lt;td style=&quot;background:#FFFFFF;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;/api/sales/:id[/receipt]&lt;/td&gt;&lt;td style=&quot;background:#FFFFFF;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;signed in&lt;/td&gt;&lt;td style=&quot;background:#FFFFFF;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;sale · receipt (from Blob)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F6F8FB;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;POST&lt;/td&gt;&lt;td style=&quot;background:#F6F8FB;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;/api/sales/:id/refund&lt;/td&gt;&lt;td style=&quot;background:#F6F8FB;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;manager&lt;/td&gt;&lt;td style=&quot;background:#F6F8FB;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;refund + restock (once)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#FFFFFF;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;GET&lt;/td&gt;&lt;td style=&quot;background:#FFFFFF;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;/api/reports/daily?date=&amp;amp;tz=&lt;/td&gt;&lt;td style=&quot;background:#FFFFFF;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;manager&lt;/td&gt;&lt;td style=&quot;background:#FFFFFF;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;gross, tax, count, average, cash/card, top 5&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F6F8FB;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;DELETE&lt;/td&gt;&lt;td style=&quot;background:#F6F8FB;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;/api/stores/current&lt;/td&gt;&lt;td style=&quot;background:#F6F8FB;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;manager + confirm&lt;/td&gt;&lt;td style=&quot;background:#F6F8FB;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;delete store, rows and receipts&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=top;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="30" y="665" width="780" height="400" as="geometry"/></mxCell><mxCell id="c52" value="D · Sign-in, sessions and roles" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0B2A4A;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=12;fontColor=#0B2A4A;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="835" y="635" width="420" height="420" as="geometry"/></mxCell><mxCell id="c53" value="&lt;b&gt;Sign-in&lt;/b&gt;&lt;br&gt;1. POST /api/auth/login {store, email, password}&lt;br&gt;2. find store by code → user by e-mail&lt;br&gt;3. scrypt verify (constant time); same 401 for any mistake&lt;br&gt;4. token = base64url(claims) . HMAC-SHA256(key)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;claims: store id, user id, role, expiry 8 h&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;key: Key Vault &lt;i&gt;pos-token-signing-key&lt;/i&gt;&lt;br&gt;5. every request: verify signature + expiry, reload user (deactivation is immediate), scope all queries to the store" style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontColor=#1F2937;verticalAlign=middle;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="850" y="665" width="395" height="170" as="geometry"/></mxCell><mxCell id="c54" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:9.5px;font-family:Segoe UI&quot;&gt;&lt;tr&gt;&lt;th style=&quot;background:#0B2A4A;color:#fff;text-align:left;padding:3px 5px&quot;&gt;Capability&lt;/th&gt;&lt;th style=&quot;background:#0B2A4A;color:#fff;text-align:left;padding:3px 5px&quot;&gt;Cashier&lt;/th&gt;&lt;th style=&quot;background:#0B2A4A;color:#fff;text-align:left;padding:3px 5px&quot;&gt;Manager&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#FFFFFF;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;Ring up sales (cash / card)&lt;/td&gt;&lt;td style=&quot;background:#FFFFFF;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;✓&lt;/td&gt;&lt;td style=&quot;background:#FFFFFF;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;✓&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F6F8FB;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;View sales and receipts&lt;/td&gt;&lt;td style=&quot;background:#F6F8FB;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;✓&lt;/td&gt;&lt;td style=&quot;background:#F6F8FB;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;✓&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#FFFFFF;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;Refund a sale&lt;/td&gt;&lt;td style=&quot;background:#FFFFFF;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;–&lt;/td&gt;&lt;td style=&quot;background:#FFFFFF;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;✓&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F6F8FB;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;Products, prices, stock&lt;/td&gt;&lt;td style=&quot;background:#F6F8FB;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;–&lt;/td&gt;&lt;td style=&quot;background:#F6F8FB;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;✓&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#FFFFFF;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;Daily report&lt;/td&gt;&lt;td style=&quot;background:#FFFFFF;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;–&lt;/td&gt;&lt;td style=&quot;background:#FFFFFF;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;✓&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F6F8FB;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;Staff and roles&lt;/td&gt;&lt;td style=&quot;background:#F6F8FB;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;–&lt;/td&gt;&lt;td style=&quot;background:#F6F8FB;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;✓&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=top;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="850" y="845" width="390" height="160" as="geometry"/></mxCell><mxCell id="c55" value="Roles are enforced by the API (403); the UI only hides tabs." style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontColor=#1F2937;verticalAlign=middle;fontSize=9.5;align=left;fontColor=#B91C1C;" vertex="1" parent="1"><mxGeometry x="850" y="1012" width="390" height="40" as="geometry"/></mxCell><mxCell id="c56" value="E · Pricing rules — worked example" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFBF5;strokeColor=#B45309;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=12;fontColor=#B45309;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1270" y="635" width="364" height="330" as="geometry"/></mxCell><mxCell id="c57" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:9.5px;font-family:Segoe UI&quot;&gt;&lt;tr&gt;&lt;th style=&quot;background:#B45309;color:#fff;text-align:left;padding:3px 5px&quot;&gt;Line&lt;/th&gt;&lt;th style=&quot;background:#B45309;color:#fff;text-align:left;padding:3px 5px&quot;&gt;Subtotal&lt;/th&gt;&lt;th style=&quot;background:#B45309;color:#fff;text-align:left;padding:3px 5px&quot;&gt;Tax&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#FFFFFF;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;2 × Coffee $2.45 (13 %)&lt;/td&gt;&lt;td style=&quot;background:#FFFFFF;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;$4.90&lt;/td&gt;&lt;td style=&quot;background:#FFFFFF;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;$0.637 → &lt;b&gt;$0.64&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F6F8FB;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;1 × Muffin $2.95 (0 %)&lt;/td&gt;&lt;td style=&quot;background:#F6F8FB;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;$2.95&lt;/td&gt;&lt;td style=&quot;background:#F6F8FB;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;$0.00&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#FFFFFF;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;&lt;b&gt;Total&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;background:#FFFFFF;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;$7.85&lt;/td&gt;&lt;td style=&quot;background:#FFFFFF;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;&lt;b&gt;$8.49&lt;/b&gt; due&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#F6F8FB;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;Cash $10.00&lt;/td&gt;&lt;td style=&quot;background:#F6F8FB;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;&lt;/td&gt;&lt;td style=&quot;background:#F6F8FB;border-bottom:1px solid #D5DDE8;padding:3px 5px;vertical-align:top&quot;&gt;change &lt;b&gt;$1.51&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=top;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1282" y="665" width="340" height="140" as="geometry"/></mxCell><mxCell id="c58" value="• integer cents end to end (no floating-point money)&lt;br&gt;• tax per line, rounded half-up, in basis points&lt;br&gt;• same rule in API (pricing.js) and UI preview (money.js), both unit-tested with this basket&lt;br&gt;• the same basket is the tester's integration and E2E oracle" style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontColor=#1F2937;verticalAlign=middle;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1282" y="815" width="345" height="160" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
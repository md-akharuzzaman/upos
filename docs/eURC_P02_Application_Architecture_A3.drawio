ontSize=10.5;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1450" y="135" width="140" height="34" as="geometry"/></mxCell><mxCell id="c34" value="" style="html=1;endArrow=none;dashed=1;strokeColor=#94A3B8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1520" y="169" as="sourcePoint"/><mxPoint x="1520" y="605" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c35" value="① POST items [{productId, qty}] + payment, Bearer" style="html=1;endArrow=block;endFill=1;strokeColor=#0B2A4A;strokeWidth=1.4;fontSize=9.5;align=left;verticalAlign=bottom;fontFamily=Segoe UI;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="820" y="195" as="sourcePoint"/><mxPoint x="1050" y="195" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c36" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#0B2A4A;strokeWidth=1.4;fontSize=9.5;align=left;verticalAlign=bottom;fontFamily=Segoe UI;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1050" y="209" as="sourcePoint"/><mxPoint x="1050" y="231" as="targetPoint"/><Array as="points"><mxPoint x="1076" y="209"/><mxPoint x="1076" y="231"/></Array></mxGeometry></mxCell><mxCell id="c37" value="② auth: verify HMAC token, user active&lt;br&gt;③ validate basket, merge duplicates" style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontColor=#1F2937;verticalAlign=middle;fontSize=9.5;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1082" y="203" width="300" height="34" as="geometry"/></mxCell><mxCell id="c38" value="④ SELECT products of this store" style="html=1;endArrow=block;endFill=1;strokeColor=#0B2A4A;strokeWidth=1.4;fontSize=9.5;align=left;verticalAlign=bottom;fontFamily=Segoe UI;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1050" y="273" as="sourcePoint"/><mxPoint x="1290" y="273" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c39" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#0B2A4A;strokeWidt
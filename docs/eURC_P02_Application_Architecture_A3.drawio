try x="48" y="359" width="189" height="64" as="geometry"/></mxCell><mxCell id="c24" value="Cart.jsx" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#087EA4;strokeWidth=1.3;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fontColor=#087EA4;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="445" width="135" height="108" as="geometry"/></mxCell><mxCell id="c25" value="lines, qty ±&lt;br&gt;subtotal, tax, total (preview)" style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontColor=#1F2937;verticalAlign=middle;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="48" y="469" width="119" height="80" as="geometry"/></mxCell><mxCell id="c26" value="CheckoutDialog" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#087EA4;strokeWidth=1.3;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fontColor=#087EA4;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="188" y="445" width="140" height="108" as="geometry"/></mxCell><mxCell id="c27" value="cash: tendered, quick amounts, change · card: terminal code" style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontColor=#1F2937;verticalAlign=middle;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="196" y="469" width="124" height="80" as="geometry"/></mxCell><mxCell id="c28" value="Receipt.jsx" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#087EA4;strokeWidth=1.3;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fontColor=#087EA4;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="340" y="445" width="130" height="108" as="geometry"/></mxCell><mxCell id="c29" value="printable 80 mm receipt · refund stamp" style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontColor=#1F2937;verticalAlign=middle;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="348" y="469" width="114" height="80" as="geometry"/></mxCell><mxCell id="c30" value="Manager screens" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#087EA4;strokeWidth=1.3;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fontColor=#087EA4;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="571" width="430" height="92" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;Products.jsx&lt;/b&gt; catalogue, price, tax, receive stock, hide · &lt;b&gt;Sales.jsx&lt;/b&gt; day list, receipt, refund&lt;br&gt;&lt;b&gt;Report.jsx&lt;/b&gt; gross, transactions, average, tax, cash / card, top products · &lt;b&gt;Team.jsx&lt;/b&gt; staff, roles, deactivate" style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontColor=#1F2937;verticalAlign=middle;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="48" y="595" width="414" height="64" as="geometry"/></mxCell><mxCell id="c32" value="lib/" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#087EA4;strokeWidth=1.3;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fontColor=#087EA4;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="681" width="430" height="104" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;api.js&lt;/b&gt; fetch wrapper: same origin, Bearer token, JSON errors&lt;br&gt;&lt;b&gt;money.js&lt;/b&gt; cents maths (mirror of API pricing), CAD format, cash parsing, quick tenders&lt;br&gt;&lt;b&gt;useLoader.js&lt;/b&gt; data loading hook (reload, 401 handling) · &lt;b&gt;dates.js&lt;/b&gt; local day + tz offset" style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontColor=#1F2937;verticalAlign=middle;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="48" y="705" width="414" height="76" as="geometry"/></mxCell><mxCell id="c34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontSize=10;fontFamily=Segoe UI;strokeColor=#087EA4;strokeWidth=1.2;" edge="1" parent="1" source="c18" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontSize=10;fontFamily=Segoe UI;strokeColor=#087EA4;strokeWidth=1.2;" edge="1" parent="1" source="c18" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontSize=10;fontFamily=Segoe UI;strokeColor=#087EA4;strokeWidth=1.2;" edge="1" parent="1" source="c22" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontSize=10;fontFamily=Segoe UI;strokeColor=#087EA4;strokeWidth=1.2;" edge="1" parent="1" source="c24" target="c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontSize=10;fontFamily=Segoe UI;strokeColor=#087EA4;strokeWidth=1.2;" edge="1" parent="1" source="c26" target="c28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c39" value="Quality (web/)" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#087EA4;strokeWidth=1.3;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fontColor=#087EA4;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="803" width="430" height="120" as="geometry"/></mxCell><mxCell id="c40" value="ESLint + react-hooks rules · &lt;b&gt;Vitest + Testing Library&lt;/b&gt;: money, Cart, CheckoutDialog, Login, whole App against a fake API (17 tests, ≥ 80 % lines) · Playwright E2E (tests/) drives the real UI in the test environment on desktop + tablet" style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontColor=#1F2937;verticalAlign=middle;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="48" y="827" width="414" height="92" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;No secrets in the browser.&lt;/b&gt; The SPA only holds the signed session token for the tab (sessionStorage, 8 h). Prices, totals, tax, stock and roles are always decided by the API." style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontColor=#1F2937;verticalAlign=middle;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="935" width="430" height="60" as="geometry"/></mxCell><mxCell id="c42" value="Build: &lt;code&gt;vite build&lt;/code&gt; → web/dist → copied to app/public in the CD build job → one package." style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontColor=#1F2937;verticalAlign=middle;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="1000" width="430" height="40" as="geometry"/></mxCell><mxCell id="c43" value="Azure App Service · Node.js 22 + Express 5 (app/) — one process serves the UI and the API" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EEF6EA;strokeColor=#3C873A;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=12;fontColor=#3C873A;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="520" y="190" width="680" height="885" as="geometry"/></mxCell><mxCell id="c44" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/app_services/App_Services.svg;" vertex="1" parent="1"><mxGeometry x="1160" y="194" width="30" height="30" as="geometry"/></mxCell><mxCell id="c45" value="Middleware pipeline (every request)" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3C873A;strokeWidth=1.3;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fontColor=#3C873A;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="540" y="225" width="640" height="100" as="geometry"/></mxCell><mxCell id="c46" value="① security headers: HSTS, &lt;b&gt;CSP&lt;/b&gt;, nosniff, frame DENY, X-EURC-Version / Environment  ② JSON body ≤ 128 kB&lt;br&gt;③ rate limiting on POST /api/stores and /api/auth/login  ④ &lt;b&gt;auth&lt;/b&gt;: Bearer token → HMAC verify (key from Key Vault, re-read on rotation) → user still active?  ⑤ &lt;b&gt;managerOnly&lt;/b&gt; for manager routes  ⑥ error handler: 4xx messages, 5xx logged only" style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontColor=#1F2937;verticalAlign=middle;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="548" y="249" width="624" height="72" as="geometry"/></mxCell><mxCell id="c47" value="/health · /health/live" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3C873A;strokeWidth=1.3;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fontColor=#3C873A;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="540" y="345" width="152" height="82" as="geometry"/></mxCell><mxCell id="c48" value="SQL, Blob, Key Vault probes;&lt;br&gt;schema version; 503 while migrating" style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontColor=#1F2937;verticalAlign=middle;fontSize=9;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="548" y="369" width="136" height="54" as="geometry"/></mxCell><mxCell id="c49" value="/api/info" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3C873A;strokeWidth=1.3;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fontCol
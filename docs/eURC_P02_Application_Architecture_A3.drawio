th=1.3;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fontColor=#3C873A;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1026" y="437" width="152" height="82" as="geometry"/></mxCell><mxCell id="c62" value="React build, deep links → index.html" style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontColor=#1F2937;verticalAlign=middle;fontSize=9;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1034" y="461" width="136" height="54" as="geometry"/></mxCell><mxCell id="c63" value="Domain (src/domain/)" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3C873A;strokeWidth=1.3;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fontColor=#3C873A;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="540" y="545" width="315" height="168" as="geometry"/></mxCell><mxCell id="c64" value="&lt;b&gt;pricing.js&lt;/b&gt; integer cents · tax in basis points, rounded half-up per line · basket validation, merge duplicates, ≤ 999 per line · cash ≥ total → change · card → terminal reference only&lt;br&gt;&lt;b&gt;auth.js&lt;/b&gt; scrypt password hashes · HMAC-SHA256 tokens, 8 h, tamper-proof&lt;br&gt;&lt;b&gt;migrations.js&lt;/b&gt; versioned, expand-only; &lt;code&gt;validateMigrations&lt;/code&gt; rejects DROP / rename" style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontColor=#1F2937;verticalAlign=middle;fontSize=9.5;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="548" y="569" width="299" height="140" as="geometry"/></mxCell><mxCell id="c65" value="Adapters (dependency-injected)" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3C873A;strokeWidth=1.3;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fontColor=#3C873A;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="865" y="545" width="315" height="168" as="geometry"/></mxCell><mxCell id="c66" value="&lt;b&gt;azure.js&lt;/b&gt; — production&lt;br&gt;• mssql pool, &lt;b&gt;token-credential&lt;/b&gt; (managed identity)&lt;br&gt;• transactions, UPDLOCK receipt numbers, sp_getapplock for migrations&lt;br&gt;• BlobServiceClient · SecretClient&lt;br&gt;&lt;b&gt;memory.js&lt;/b&gt; — same contract, for local dev + unit tests" style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontColor=#1F2937;verticalAlign=middle;fontSize=9.5;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="873" y="569" width="299" height="140" as="geometry"/></mxCell><mxCell id="c67" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontSize=10;fontFamily=Segoe UI;strokeColor=#0B2A4A;" edge="1" parent="1" source="c57" target="c63"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c68" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontSize=10;fontFamily=Segoe UI;strokeColor=#0B2A4A;" edge="1" parent="1" source="c63" target="c65"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c69" value="Start-up (server.js)" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3C873A;strokeWidth=1.3;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fontColor=#3C873A;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="540" y="731" width="315" height="104" as="geometry"/></mxCell><mxCell id="c70" value="listen → apply pending migrations under app lock → ready (health 200)&lt;br&gt;retry with back-off · graceful SIGTERM · telemetry first (OpenTelemetry → App Insights)" style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontColor=#1F2937;verticalAlign=middle;fontSize=9.5;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="548" y="755" width="299" height="76" as="geometry"/></mxCell><mxCell id="c71" value="Configuration (app settings)" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3C873A;strokeWidth=1.3;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fontColor=#3C873A;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="865" y="731" width="315" height="104" as="geometry"/></mxCell><mxCell id="c72" value="EURC_ENVIRONMENT · EURC_SLOT (sticky) · AZURE_CLIENT_ID · SQL_SERVER / SQL_DATABASE · STORAGE_BLOB_URL · KEY_VAULT_URL · APPLICATIONINSIGHTS_CONNECTION_STRING — &lt;b&gt;no passwords or keys&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontColor=#1F2937;verticalAlign=middle;fontSize=9.5;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="873" y="755" width="299" height="76" as="geometry"/></mxCell><mxCell id="c73" value="Quality (app/)" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3C873A;strokeWidth=1.3;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fontColor=#3C873A;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="540" y="853" width="640" height="92" as="geometry"/></mxCell><mxCell id="c74" value="ESLint · &lt;b&gt;31 node:test tests&lt;/b&gt; (domain maths, tokens, roles, checkout, all-or-nothing stock, refunds, report, store isolation, health failure modes) · coverage ≥ 80 % lines · npm audit · pipeline suites: smoke 8, integration 13, load gate" style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontColor=#1F2937;verticalAlign=middle;fontSize=9.5;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="548" y="877" width="624" height="64" as="geometry"/></mxCell><mxCell id="c75" value="build.json (version, commit, run) travels in the package → shown by /api/info, the UI badge and every log line." style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontColor=#1F2937;verticalAlign=middle;fontSize=10;align=left;" vertex="1" parent="1"><mxGeometry x="540" y="960" width="640" height="40" as="geometry"/></mxCell><mxCell id="c76" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontSize=10;fontFamily=Segoe UI;strokeColor=#0078D4;strokeWidth=2.5;exitX=1;exitY=0.62;entryX=0;entryY=0.6;" edge="1" parent="1" source="c18" target="c45"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c77" value="&lt;b&gt;HTTPS&lt;br&gt;JSON&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontColor=#1F2937;verticalAlign=middle;fontSize=8.5;align=center;fontColor=#0078D4;" vertex="1" parent="1"><mxGeometry x="486" y="236" width="40" height="30" as="geometry"/></mxCell><mxCell id="c78" value="HTTPS (TLS 1.2+)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontSize=10;fontFamily=Segoe UI;strokeColor=#0078D4;strokeWidth=2;entryX=0.88;entryY=0;" edge="1" parent="1" target="c18"><mxGeometry relative="1" as="geometry"><mxPoint x="275" y="160" as="sourcePoint"/><Array as="points"><mxPoint x="418" y="160"/></Array></mxGeometry></mxCell><mxCell id="c79" value="every route below passes through the middleware" style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontColor=#1F2937;verticalAlign=middle;fontSize=9;fontColor=#3C873A;align=left;" vertex="1" parent="1"><mxGeometry x="540" y="327" width="400" height="16" as="geometry"/></mxCell><mxCell id="c80" value="Azure data services (per environment)" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F3EEFA;strokeColor=#5C2D91;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=12;fontColor=#5C2D91;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1230" y="190" width="404" height="885" as="geometry"/></mxCell><mxCell id="c81" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/identity/Managed_Identities.svg;" vertex="1" parent="1"><mxGeometry x="1250" y="230" width="40" height="40" as="geometry"/></mxCell><mxCell id="c82" value="id-eurc-app-&amp;lt;env&amp;gt;-cc&lt;br&gt;user-assigned, both slots" style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontColor=#1F2937;verticalAlign=middle;align=left;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1296" y="226" width="170" height="48" as="geometry"/></mxCell><mxCell id="c83" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/databases/SQL_Database.svg;" vertex="1" parent="1"><mxGeometry x="1250" y="330" width="44" height="44" as="geometry"/></mxCell><mxCell id="c84" value="&lt;b&gt;Azure SQL&lt;/b&gt; (T-SQL over TDS) sqldb-eurc-core-&amp;lt;env&amp;gt;&lt;br&gt;stores · users · products · sales · sale_lines · schema_migrations&lt;br&gt;Entra-only auth (identity = Entra admin)" style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontColor=#1F2937;verticalAlign=middle;fontSize=10;align=left;" vertex="1" parent="1"><mxGeometry x="1302" y="318" width="320" height="70" as="geometry"/></mxCell><mxCell id="c85" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/storage/Storage_Accounts.svg;" vertex="1" parent="1"><mxGeometry x="1250" y="440" width="44" height="44" as="geometry"/></mxCell><mxCell id="c86" value="&lt;b&gt;Blob Storage&lt;/b&gt; container &lt;i&gt;pos-receipts&lt;/i&gt;&lt;br&gt;receipts/&amp;lt;storeId&amp;gt;/&amp;lt;saleId&amp;gt;.json&lt;br&gt;rebuilt from SQL if a blob is missing" style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontColor=#1F2937;verticalAlign=middle;fontSize=10;align=left;" vertex="1" parent="1"><mxGeometry x="1302" y="428" width="320" height="70" as="geometry"/></mxCell><mxCell id="c87" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/security/Key_Vaults.svg;" vertex="1" parent="1"><mxGeometry x="1250" y="550" width="44" height="44" as="geometry"/></mxCell><mxCell id="c88" value="&lt;b&gt;Key Vault&lt;/b&gt; secret &lt;i&gt;pos-token-signing-key&lt;/i&gt;&lt;br&gt;created on first start; shared by all instances and both slots, so a swap keeps cashiers signed in" style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontColor=#1F2937;verticalAlign=middle;fontSize=10;align=left;" vertex="1" parent="1"><mxGeometry x="1302" y="538" width="320" height="70" as="geometry"/></mxCell><mxCell id="c89" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/devops/Application_Insights.svg;" vertex="1" parent="1"><mxGeometry x="1250" y="660" width="44" height="44" as="geometry"/></mxCell><mxCell id="c90" value="&lt;b&gt;Application Insights&lt;/b&gt; (+ Log Analytics)&lt;br&gt;requests, dependencies (SQL, Blob, KV), exceptions, tagged with version, environment, slot" style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontColor=#1F2937;verticalAlign=middle;fontSize=10;align=left;" vertex="1" parent="1"><mxGeometry x="1302" y="648" width="320" height="70" as="geometry"/></mxCell><mxCell id="c91" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontSize=10;fontFamily=Segoe UI;strokeColor=#7030A0;dashed=1;" edge="1" parent="1" source="c81" target="c83"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c92" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontSize=10;fontFamily=Segoe UI;strokeColor=#7030A0;dashed=1;exitX=1;exitY=0.12;entryX=0;entryY=0.5;" edge="1" parent="1" source="c65" target="c83"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1196" y="565"/><mxPoint x="1196" y="352"/></Array></mxGeometry></mxCell><mxCell id="c93" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontSize=10;fontFamily=Segoe UI;strokeColor=#7030A0;dashed=1;exitX=1;exitY=0.37;entryX=0;entryY=0.5;" edge="1" parent="1" source="c65" target=
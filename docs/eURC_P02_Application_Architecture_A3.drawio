-size:9px;width:34px'&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;font-size:10px'&gt;line_subtotal_cents&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px;color:#94A3B8;font-size:9px;width:34px'&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;font-size:10px'&gt;line_tax_cents&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;verticalAlign=top;align=left;spacing=0;overflow=hidden;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="520" y="330" width="175" height="152" as="geometry"/></mxCell><mxCell id="c20" value="&lt;div style='background:#5C2D91;color:#fff;font-weight:700;padding:4px 8px;font-size:11px;width:159px'&gt;dbo.schema_migrations&lt;/div&gt;&lt;table style='border-collapse:collapse;width:100%;font-family:Segoe UI'&gt;&lt;tr&gt;&lt;td style='padding:1px 6px;color:#B45309;font-size:9px;width:34px'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;font-size:10px'&gt;version&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px;color:#94A3B8;font-size:9px;width:34px'&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;font-size:10px'&gt;name&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px;color:#94A3B8;font-size:9px;width:34px'&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;font-size:10px'&gt;app_version&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px;color:#94A3B8;font-size:9px;width:34px'&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;font-size:10px'&gt;applied_at&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;verticalAlign=top;align=left;spacing=0;overflow=hidden;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="520" y="140" width="175" height="92" as="geometry"/></mxCell><mxCell id="c21" value="1 : n" style="edgeStyle=entityRelationEdgeStyle;h
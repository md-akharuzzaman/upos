# eURC Hands-on Project 02 — settings for the Cloud Shell scripts.
# Edit the three values marked CHANGE ME, then run ./setup.sh

# --- GitHub --------------------------------------------------------------
GITHUB_OWNER="md-akharuzzaman"		      # CHANGE ME: your GitHub user (or org)
GITHUB_REPO="upos"	                      # repository the kit is pushed to
GITHUB_VISIBILITY="public"                    # public: environment approvals work on GitHub Free
                                              # private: needs GitHub Pro (free with the Student Pack)

# --- Delivery team (GitHub user names) -----------------------------------
# 2 developers + 1 tester. The repository owner above is the team lead and
# may also be one of the developers. Leave a name empty to skip it for now.
DEV1="md-akharuzzaman"		              # CHANGE ME: developer 1 (often the owner)
DEV2="CHANGE-ME-developer-2"                  # CHANGE ME: developer 2
TESTER="CHANGE-ME-tester"                     # CHANGE ME: QA engineer - owns tests/, signs off prod releases

# --- Alerts and budget -----------------------------------------------------
ALERT_EMAIL="akharuzzaman@gmail.com"          # CHANGE ME: receives production alerts + budget mails
BUDGET_AMOUNT=60                              # monthly budget (subscription currency) for eURC resource groups

# --- Azure ---------------------------------------------------------------
LOCATION="canadacentral"
LOC_SHORT="cc"
ENVIRONMENTS="dev test prod"

# Resource groups (CAF naming). One per environment = one lifecycle and
# permission boundary; the deployment identities live in their own group.
RG_CICD="rg-eurc-cicd-${LOC_SHORT}"
rg_for() { echo "rg-eurc-$1-${LOC_SHORT}"; }

# Tags applied to every resource group
TAG_APPLICATION="eurc"
TAG_COSTCENTER="cc-eurc-lab"
TAG_OWNER="platform-team"
